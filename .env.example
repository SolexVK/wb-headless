# Шаблон переменных окружения. Скопируйте в .env и впишите реальные значения:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore), реальные токены остаются локально.

# Токен MPSTATS (заголовок X-Mpstats-TOKEN)
MPSTATS_TOKEN=

# Необязательно: базовый URL MPStats API (по умолчанию https://mpstats.io/api)
# MPSTATS_BASE=https://mpstats.io/api

# Ключ для доступа к этому API (заголовок x-api-key)
API_KEY=supersecret

# Порт HTTP-сервера
PORT=8080

# --- ABC(-XYZ) анализ товарной матрицы (все необязательные) ---
# Показатель ранжирования ABC: revenue (по умолчанию) или units
# ABC_METRIC=revenue
# Границы классов ABC (накопленная доля, %) и XYZ (коэффициент вариации, %)
# ABC_A_PCT=80
# ABC_B_PCT=95
# ABC_X_CV=10
# ABC_Y_CV=25

# --- WB Seller API: история остатков (поправка ABC на наличие) ---
# Токен WB (категории «Аналитика» и «Статистика»). Заголовок Authorization.
WB_TOKEN=
# Базовые хосты (менять обычно не нужно)
# WB_STATS_BASE=https://statistics-api.wildberries.ru
# WB_ANALYTICS_BASE=https://seller-analytics-api.wildberries.ru
# ⚠ ЛИМИТЫ (защита от бана). Минимальный интервал между запросами, мс.
# По умолчанию консервативно: статистика ~1/мин, аналитика ~3/мин.
# WB_STATS_MIN_INTERVAL_MS=61000
# WB_ANALYTICS_MIN_INTERVAL_MS=21000
# Асинхронный отчёт истории остатков (пути ПРОВЕРЕНЫ на живом API):
#   POST {DOWNLOADS_PATH}                → создать (тело с id/reportType/params)
#   GET  {DOWNLOADS_PATH}?filter[downloadIds]=<id>  → статус (SUCCESS/FAILED)
#   GET  {DOWNLOADS_PATH}/file/<id>      → ZIP с CSV (широкий формат, колонки-даты)
# WB_DOWNLOADS_PATH=/api/v2/nm-report/downloads
# Тип отчёта: STOCK_HISTORY_DAILY_CSV (до 3 мес, без Jam) или
#             DETAIL_HISTORY_REPORT (до года, требует подписку Jam).
# WB_STOCK_REPORT_TYPE=STOCK_HISTORY_DAILY_CSV
# Тип остатка: пусто = склады WB, mp = маркетплейс/FBS
# WB_STOCK_TYPE=
