# Шаблон переменных окружения. Скопируйте в .env и впишите реальные значения:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore), реальные токены остаются локально.

# Токен MPSTATS (заголовок X-Mpstats-TOKEN)
MPSTATS_TOKEN=

# Токен(ы) официального API Wildberries — для сводного отчёта по остаткам
# (report-wb-stock.js, эндпоинт /reports/wb-stock).
# Достаточно одного токена, если у него есть категории «Статистика»,
# «Маркетплейс» и «Контент». Иначе задайте раздельные токены ниже.
WB_API_TOKEN=
# Необязательно: раздельные токены по категориям (перебивают WB_API_TOKEN)
# WB_STATS_TOKEN=
# WB_MARKETPLACE_TOKEN=
# WB_CONTENT_TOKEN=
# Необязательно: переопределение хостов WB (по умолчанию — боевые)
# WB_STATS_HOST=https://statistics-api.wildberries.ru
# WB_MARKETPLACE_HOST=https://marketplace-api.wildberries.ru
# WB_CONTENT_HOST=https://content-api.wildberries.ru

# Необязательно: базовый URL MPStats API (по умолчанию https://mpstats.io/api)
# MPSTATS_BASE=https://mpstats.io/api

# Ключ для доступа к этому API (заголовок x-api-key)
API_KEY=supersecret

# Порт HTTP-сервера
PORT=8080
