# Шаблон переменных окружения. Скопируйте в .env и впишите реальные значения:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore), реальные токены остаются локально.

# Токен MPSTATS (заголовок X-Mpstats-TOKEN)
MPSTATS_TOKEN=

# Необязательно: базовый URL MPStats API (по умолчанию https://mpstats.io/api)
# MPSTATS_BASE=https://mpstats.io/api

# Ключ для доступа к этому API (заголовок x-api-key)
API_KEY=supersecret

# Порт HTTP-сервера
PORT=8080

# ── Telegram-бот (npm run bot) — мост в Claude Agent ──────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш chat id — только он сможет писать боту (узнать: напишите боту, он ответит id)
TELEGRAM_ALLOWED_CHAT=
# Ключ Claude API для движка агента
ANTHROPIC_API_KEY=
# Необязательно: модель и режим прав агента
# CLAUDE_MODEL=claude-opus-4-8
# CLAUDE_PERMISSION_MODE=acceptEdits
# Необязательно: рабочая папка агента (по умолчанию — папка проекта)
# BOT_WORKDIR=
# Необязательно: таймаут одной задачи в мс (по умолчанию 600000 = 10 мин)
# AGENT_TIMEOUT_MS=600000
# Необязательно: файл состояния (по умолчанию .bot-state.json рядом с ботом)
# BOT_STATE_FILE=
