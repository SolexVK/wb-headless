# Шаблон переменных окружения. Скопируйте в .env и впишите реальные значения:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore), реальные токены остаются локально.

# Токен MPSTATS (заголовок X-Mpstats-TOKEN)
MPSTATS_TOKEN=

# ПЕРСОНАЛЬНЫЙ токен Wildberries API (заголовок Authorization).
# Клиент lib/wbClient.js читает WB_API_TOKEN, а также запасным именем Wildberries_API —
# достаточно задать любое из них. Тип токена — в WB_TOKEN_TYPE (personal|service|base|test).
Wildberries_API=
# WB_TOKEN_TYPE=personal

# Необязательно: базовый URL MPStats API (по умолчанию https://mpstats.io/api)
# MPSTATS_BASE=https://mpstats.io/api

# Ключ для доступа к этому API (заголовок x-api-key)
API_KEY=supersecret

# Порт HTTP-сервера
PORT=8080
