# Шаблон переменных окружения. Скопируйте в .env и впишите реальные значения:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore), реальные токены остаются локально.

# Токен MPSTATS (заголовок X-Mpstats-TOKEN)
MPSTATS_TOKEN=

# Необязательно: базовый URL MPStats API (по умолчанию https://mpstats.io/api)
# MPSTATS_BASE=https://mpstats.io/api

# Ключ для доступа к этому API (заголовок x-api-key)
API_KEY=supersecret

# Порт HTTP-сервера
PORT=8080

# --- Отчёт «Топ рубашек в полоску за сезон» (report:category) ---
# Необязательные настройки, у всех есть значения по умолчанию (см. REPORTS.md).
# CATEGORY_SELECTOR=Рубашки
# CATEGORY_TOP_N=10
# STRIPE_KEYWORDS=полоск,полос,striped,stripe,pinstripe
# CATEGORY_PAGE_SIZE=500
# CATEGORY_MAX_ROWS=3000
