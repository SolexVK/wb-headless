# Шаблон переменных окружения. Скопируйте в .env и впишите реальные значения:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore), реальные токены остаются локально.

# Токен MPSTATS (заголовок X-Mpstats-TOKEN)
MPSTATS_TOKEN=

# Необязательно: базовый URL MPStats API (по умолчанию https://mpstats.io/api)
# MPSTATS_BASE=https://mpstats.io/api

# Ключ для доступа к этому API (заголовок x-api-key)
API_KEY=supersecret

# Порт HTTP-сервера
PORT=8080

# --- Анализ ниши (report-niche.js) ---
# Путь категории WB по умолчанию (можно передать аргументом/через ?path=)
# NICHE_PATH=Женщинам/Одежда/Платья
# Сколько товаров максимум выгружать (верх по выручке) и размер страницы
# NICHE_MAX_ROWS=5000
# NICHE_PAGE_SIZE=500
# Фаза 2 — насыщенность по поисковому запросу:
# NICHE_QUERY=платье летнее
# NICHE_FREQ=25000            # частотность (для «спрос:предложение»); источник — Wildbox
# NICHE_QUERY_MAX_ROWS=2000   # предел выгрузки поисковой выдачи
# NICHE_THRESHOLDS=./config/niche-thresholds.json  # свой файл порогов скоринга
# Автоотбор уточняющих фраз из выгрузки Оракула (Wildbox):
# NICHE_ORACLE=./oracle.xlsx          # файл выгрузки (xlsx или csv)
# NICHE_PLUS=клетка,оверсайз,фланель  # взять фразу, если есть хотя бы один ключ
# NICHE_MINUS=летняя,муслин,блузка    # выкинуть фразу с любым из этих ключей
# Себестоимость единицы — включает блок экономики/маржи в отчёте:
# NICHE_COST=600
# PDF-отчёт (по умолчанию собирается, если найден Chromium):
# NICHE_PDF=0                         # 0 — не собирать PDF (только HTML/CSV/JSON)
# CHROMIUM_PATH=/opt/pw-browsers/chromium  # путь к Chromium, если не найден автоматически
