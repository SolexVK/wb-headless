{
  "name": "wb-headless",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "express": "^4.19.2",
    "puppeteer": "^22.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "scripts": {
    "build:chrome": "npx @puppeteer/browsers install chrome@stable --install-dir=./chrome --cache-dir=./chrome",
    "start": "node server.js",
    "report:stock": "node report-stock.js",
    "token:check": "node scripts/wb-token-check.mjs",
    "docs:fetch": "node scripts/fetch-wb-docs.mjs",
    "docs:limits": "node scripts/fetch-wb-docs.mjs https://dev.wildberries.ru/docs/openapi/api-information docs/wb-api/limits.md",
    "wb:warehouses": "node scripts/wb-warehouses.mjs",
    "fbs:stock": "node scripts/fbs-stock.mjs",
    "fbs:dashboard": "node scripts/fbs-dashboard.mjs",
    "fbs:retro": "node scripts/fbs-orders-retro.mjs",
    "fbs:report": "node scripts/fbs-report.mjs",
    "fbs:pdf": "node scripts/fbs-pdf.mjs",
    "fbs:stock:pdf": "node scripts/fbs-stock-pdf.mjs",
    "fbs:delivery": "node scripts/fbs-delivery-daily.mjs",
    "fbs:delivery:dash": "node scripts/fbs-delivery-dashboard.mjs",
    "fbs:accepted:dash": "node scripts/fbs-accepted-dashboard.mjs",
    "fbs:stock:articles": "node scripts/fbs-stock-by-article.mjs",
    "fbs:dashboards": "npm run fbs:stock && npm run fbs:delivery && npm run fbs:delivery:dash && npm run fbs:accepted:dash && npm run fbs:stock:articles"
  },
  "engines": {
    "node": ">=18"
  }
}
