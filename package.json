{
  "name": "wb-headless",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "express": "^4.19.2",
    "puppeteer": "^22.10.0",
    "uuid": "^9.0.1"
  },
  "scripts": {
    "build:chrome": "npx @puppeteer/browsers install chrome@stable --install-dir=./chrome --cache-dir=./chrome",
    "start": "node server.js",
    "report:stock": "node report-stock.js",
    "report:niche": "node report-niche.js",
    "report:fines": "node report-fines.js",
    "report:forensics": "node report-forensics.mjs",
    "watch:wb": "node agent-wb-watch.mjs",
    "watch:wb:dry": "node agent-wb-watch.mjs --dry-run",
    "watch:selftest": "node scripts/wb-watch-selftest.mjs",
    "watch:install": "bash scripts/mac-mini-install.sh"
  },
  "engines": {
    "node": ">=18"
  }
}
