{
  "name": "wb-headless",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "express": "^4.19.2",
    "puppeteer": "^22.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  },
  "scripts": {
    "build:chrome": "npx @puppeteer/browsers install chrome@stable --install-dir=./chrome --cache-dir=./chrome",
    "start": "node server.js",
    "report:stock": "node report-stock.js",
    "report:fire": "node report-fire-losses.mjs",
    "report:cabinet": "node report-cabinet.mjs",
    "pdf:cabinet": "node scripts/build-cabinet-pdf.mjs",
    "pdf:fire": "node scripts/build-fire-pdf.mjs",
    "token:check": "node scripts/wb-token-check.mjs",
    "docs:fetch": "node scripts/fetch-wb-docs.mjs",
    "docs:limits": "node scripts/fetch-wb-docs.mjs https://dev.wildberries.ru/docs/openapi/api-information docs/wb-api/limits.md"
  },
  "engines": {
    "node": ">=18"
  }
}
