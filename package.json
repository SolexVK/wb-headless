{
  "name": "wb-headless",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.19.2",
    "grammy": "^1.44.0",
    "puppeteer": "^22.10.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  },
  "scripts": {
    "build:chrome": "npx @puppeteer/browsers install chrome@stable --install-dir=./chrome --cache-dir=./chrome",
    "start": "node server.js",
    "report:stock": "node report-stock.js",
    "token:check": "node scripts/wb-token-check.mjs",
    "cabinet:check": "node scripts/wb-cabinet-check.mjs",
    "cards:compare": "node scripts/wb-cards-compare.mjs",
    "top:keywords": "node scripts/wb-top-keywords.mjs",
    "analysis:competitive": "python3 .claude/skills/wb-competitor-analysis/wb_analyze.py",
    "pipeline": "node scripts/wb-pipeline.mjs",
    "docs:fetch": "node scripts/fetch-wb-docs.mjs",
    "docs:limits": "node scripts/fetch-wb-docs.mjs https://dev.wildberries.ru/docs/openapi/api-information docs/wb-api/limits.md",
    "sales:by-keyword": "node scripts/wb-brand-keyword-sales.mjs",
    "db": "node db-cli.js",
    "db:stats": "node db-cli.js stats",
    "db:sync": "node db-cli.js sync",
    "bot": "node --env-file-if-exists=.env bot/index.js"
  },
  "engines": {
    "node": ">=18"
  }
}
