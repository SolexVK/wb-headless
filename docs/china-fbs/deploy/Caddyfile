# Единый обратный прокси для публичного входа 443 (за Tailscale Funnel).
#
# Tailscale Funnel терминирует HTTPS и проксирует ОДИН порт 443 → сюда (127.0.0.1:9000).
# Caddy дальше маршрутизирует по путям. Добавление нового сервиса = новый handle-блок
# ниже + `caddy reload` (или перезапуск brew-сервиса). Funnel при этом НЕ трогаем —
# именно это устраняет гонки за общий funnel-конфиг.
#
# ВАЖНО про пути: Tailscale с `--set-path=/calc` префикс НЕ срезает — приложение tandemtrace
# обслуживается прямо по `/calc`. Поэтому используем `handle` (сохраняет путь), а НЕ
# `handle_path` (срезал бы префикс и сломал бэкенд).

{
	# Funnel сам даёт HTTPS; Caddy слушает чистый HTTP на loopback.
	auto_https off
}

http://127.0.0.1:9000 {
	# tandemtrace / «UNIT-калькулятор WB» — обслуживается по пути /calc, префикс сохраняем.
	# Именованный матчер: handle принимает только ОДИН путь-аргумент, поэтому список путей — через @.
	@calc path /calc /calc/*
	handle @calc {
		reverse_proxy 127.0.0.1:8899
	}

	# wbheadless.planner — корень и всё остальное.
	handle {
		reverse_proxy 127.0.0.1:8477
	}
}

# --- Как добавить новый сервис в будущем (пример) -------------------------------
# 1. Подними сервис на своём локальном порту, напр. 127.0.0.1:9100.
# 2. Добавь блок ВЫШЕ дефолтного handle (несколько путей — через именованный матчер):
#        @myapp path /myapp /myapp/*
#        handle @myapp {
#            reverse_proxy 127.0.0.1:9100
#        }
#    (порядок важен: более специфичные пути — раньше дефолтного handle)
# 3. Если приложение обслуживается по корню, а на /myapp срезать префикс — используй
#    handle_path вместо handle.
# 4. Применить без даунтайма: caddy reload --config /opt/homebrew/etc/Caddyfile
#    (или: brew services restart caddy)
# 5. Funnel НЕ трогаем — 443 уже указывает на Caddy.
