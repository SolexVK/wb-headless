# GetCourse downloader configuration.
# Copy this file to ".env" and fill in your values. The .env file is git-ignored.

# Login credentials for your GetCourse account
GC_EMAIL=you@example.com
GC_PASSWORD=your-password

# Starting page of the course. Any block/module page of the course works — the
# crawler follows all blocks of that course automatically.
GC_START_URL=https://your-school.getcourse.ru/teach/control/stream/view/id/000000000

# Where to save videos (folder tree mirrors the site). Default: ./output
GC_OUTPUT=./output

# Parallel segment downloads per video. Default: 10
GC_CONCURRENCY=10

# --- Optional / advanced (CLI) ---
# Path to ffmpeg if it is not on PATH (macOS with Homebrew: usually just "ffmpeg")
# FFMPEG=/opt/homebrew/bin/ffmpeg
# Path to a specific Chromium binary (otherwise Playwright's managed one is used)
# CHROMIUM_PATH=
# Run with a visible browser window for debugging
# GC_HEADFUL=1
# Disable the TLS1.2/HTTP1.1 anti-bot workaround (only needed behind some proxies)
# GC_NO_TLS_WORKAROUND=1

# ======================================================================
# Web interface (npm run web). The CLI vars above are NOT required for the
# web UI — there you enter the GetCourse login/URL/folder in the browser.
# ======================================================================

# Port and bind address. 127.0.0.1 keeps it local; Tailscale proxies to it.
# 8080 is used by another project on this machine — 7837 avoids the clash.
GCUI_PORT=7837
GCUI_HOST=127.0.0.1

# First-run admin account (created only if there are no users yet).
GCUI_ADMIN_USER=admin
GCUI_ADMIN_PASS=change-me-please

# Root folder the OWNER's "choose folder" picker is confined to (default: home).
# Only owner/admin accounts (localAccess) can browse and save here. Regular
# subscribers never see the server filesystem — they use delivery mode below.
# GCUI_BROWSE_ROOT=/Users/you/Movies

# --- Delivery mode (subscribers) ---------------------------------------
# Subscribers' videos land in a temporary per-user spool, are downloaded via the
# browser, counted against a daily quota, then auto-deleted.

# Temp spool folder (default: web/spool)
# GCUI_SPOOL_ROOT=./web/spool
# Delete a delivered file this many minutes after its last download/creation.
GCUI_RETENTION_MIN=30
# Daily volume a subscriber may produce (GB). 0 disables the check.
GCUI_DAILY_GB=200
# Optional daily file-count cap (0 = unlimited).
GCUI_DAILY_FILES=0
# Max spool footprint per user at any moment (GB); 0 = same as GCUI_DAILY_GB.
GCUI_USER_QUOTA_GB=200

# --- Registration & accounts -------------------------------------------
# Public sign-up (email + password). 1/on by default; set 0 to allow only
# admin-created accounts.
# GCUI_ALLOW_SIGNUP=1
# Auto-grant a subscription for N days on sign-up (until real payment is wired).
# Set 0 to require a key/payment instead.
GCUI_SIGNUP_LICENSE_DAYS=30
# Public URL of the service (used for OAuth redirect + password-reset links).
GCUI_PUBLIC_URL=https://mac-mini-vital.tail13d29e.ts.net:8443

# Google sign-in (optional). Create an OAuth client at console.cloud.google.com,
# add the redirect URI  <GCUI_PUBLIC_URL>/api/auth/google/callback , then set:
# GCUI_GOOGLE_CLIENT_ID=
# GCUI_GOOGLE_CLIENT_SECRET=

# Password-reset emails (optional). Without SMTP, reset links appear in the
# admin panel for manual delivery.
# GCUI_SMTP_HOST=
# GCUI_SMTP_PORT=587
# GCUI_SMTP_USER=
# GCUI_SMTP_PASS=
# GCUI_SMTP_FROM=

# --- Paid access -------------------------------------------------------
# License keys a user can redeem in the UI to activate a subscription for
# GCUI_LICENSE_DAYS days.
# GCUI_LICENSE_KEYS=KEY-AAA,KEY-BBB
# GCUI_LICENSE_DAYS=30
# GCUI_PRICE_NOTE=Подписка 990₽/мес. Ключ выдаёт администратор.

# ЮKassa (card payments) — implemented but DISABLED by default. Set
# GCUI_YOOKASSA_ENABLED=1 plus credentials to turn it on later; no code change.
# GCUI_YOOKASSA_ENABLED=1
# GCUI_YOOKASSA_SHOP_ID=
# GCUI_YOOKASSA_SECRET=
# GCUI_YOOKASSA_AMOUNT=990.00
# GCUI_YOOKASSA_CURRENCY=RUB
# GCUI_YOOKASSA_DAYS=30
# GCUI_YOOKASSA_RETURN_URL=https://getcourse.<tailnet>.ts.net/

# Where the app stores its DB (users/sessions/jobs). Default: web/data
# GCUI_DATA=./web/data

# Allow non-Secure cookie (only for plain http://localhost testing without HTTPS)
# GCUI_COOKIE_INSECURE=1
