<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent to auto-start the GetCourse Downloader web UI on the Mac Mini.

  Install:
    1. Edit the paths/values below (node path, project path, admin pass).
    2. cp scripts/com.getcourse.downloader.plist.example \
         ~/Library/LaunchAgents/com.getcourse.downloader.plist
    3. launchctl load ~/Library/LaunchAgents/com.getcourse.downloader.plist
    4. launchctl start com.getcourse.downloader

  Logs: /tmp/getcourse-downloader.out / .err
  Stop:  launchctl unload ~/Library/LaunchAgents/com.getcourse.downloader.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.getcourse.downloader</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOU/wb-headless/getcourse/web/server.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOU/wb-headless/getcourse</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>GCUI_PORT</key><string>7837</string>
    <key>GCUI_HOST</key><string>127.0.0.1</string>
    <key>GCUI_ADMIN_USER</key><string>admin</string>
    <key>GCUI_ADMIN_PASS</key><string>ЗАМЕНИТЕ_МЕНЯ</string>
    <key>GCUI_BROWSE_ROOT</key><string>/Users/YOU/Movies</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>

  <key>StandardOutPath</key><string>/tmp/getcourse-downloader.out</string>
  <key>StandardErrorPath</key><string>/tmp/getcourse-downloader.err</string>
</dict>
</plist>
