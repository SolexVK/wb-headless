# Конфигурация FBS-сервиса. Скопируйте в .env и задайте значения:  cp .env.example .env
# Слушаем ТОЛЬКО loopback (правила Mac Mini): публикацию наружу делает Caddy.
HOST=127.0.0.1
PORT=9110
NODE_ENV=development

# Префикс пути, под которым сервис публикуется наружу через Caddy (path-маршрут).
# Пусто = корень. На Mac Mini публикуем под /fbs → адрес .../fbs/.
BASE_PATH=/fbs

# Секрет для подписи сессионных cookie (обязательно; длинная случайная строка).
#   сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Ключ шифрования WB-токенов (AES-256-GCM), 32 байта в hex (64 символа). Нужен с Фазы 1.
#   сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# Путь к файлу БД SQLite.
DB_PATH=./data/app.sqlite

# Онлайн-проверка WB-токена через /ping при привязке кабинета (Фаза 1).
# 1/true — проверять по сети (по умолчанию); 0/false — только по маске токена (офлайн).
WB_PING_ONLINE=1

# Лицензия: сколько мест (человек, включая владельца) у новой компании по умолчанию.
DEFAULT_LICENSE_SEATS=1

# Супер-админы (могут менять число мест компаний на /admin). Email через запятую.
SUPER_ADMIN_EMAILS=solexvk@gmail.com
