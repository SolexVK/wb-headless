# Конфигурация FBS-сервиса. Скопируйте в .env и задайте значения:  cp .env.example .env
# Слушаем ТОЛЬКО loopback (правила Mac Mini): публикацию наружу делает Caddy.
HOST=127.0.0.1
PORT=9110
NODE_ENV=development

# Секрет для подписи сессионных cookie (обязательно; длинная случайная строка).
#   сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Ключ шифрования WB-токенов (AES-256-GCM), 32 байта в hex (64 символа). Нужен с Фазы 1.
#   сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# Путь к файлу БД SQLite.
DB_PATH=./data/app.sqlite
